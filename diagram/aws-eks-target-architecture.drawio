        <!-- NOTES -->
        <mxCell id="note1" value="&lt;b&gt;Hai tầng tự phục hồi&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Tầng pod&lt;/b&gt; — kubelet restart container, Deployment lập lịch lại pod. &lt;b&gt;Vài giây&lt;/b&gt;, và không phải kéo lại image vì image đã nằm sẵn trên node.&lt;br&gt;&lt;br&gt;&lt;b&gt;Tầng node&lt;/b&gt; — Cluster Autoscaler thay node qua ASG bên dưới. &lt;b&gt;Vài phút&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Kubernetes tự lo cả hai bằng chính sách cố định. Đóng góp của đề tài là &lt;b&gt;chọn đúng tầng&lt;/b&gt; dựa trên chẩn đoán." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#D86613;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2130" y="200" width="280" height="270" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;Vì sao cần AI khi K8s đã tự phục hồi&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bốn triệu chứng dưới đây trông giống nhau nhưng cần bốn hành động ở bốn tầng khác nhau:&lt;br&gt;&lt;br&gt;• OOMKilled 1 pod → &lt;b&gt;tăng memory limit&lt;/b&gt;&lt;br&gt;• OOMKilled mọi pod sau deploy → &lt;b&gt;rollout undo&lt;/b&gt;&lt;br&gt;• Chỉ pod trên node X lỗi → &lt;b&gt;cordon node X&lt;/b&gt;&lt;br&gt;• FailedScheduling toàn cụm → &lt;b&gt;thêm node&lt;/b&gt;&lt;br&gt;&lt;br&gt;K8s chỉ biết restart rồi backoff. CrashLoopBackOff chính là biểu hiện của việc lặp lại một hành động đúng ở &lt;i&gt;sai tầng&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F5FC;strokeColor=#2B5EBE;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2130" y="500" width="280" height="300" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="&lt;b&gt;Khác biệt so với phương án ASG&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Không còn AMI, cloud-init, app-release-deploy.sh&lt;br&gt;• Không còn SSM Parameter Store cho tag image&lt;br&gt;• Rollback nguyên tử sẵn có (rollout undo)&lt;br&gt;• Tín hiệu có cấu trúc thay vì nhị phân pass/fail&lt;br&gt;• Phục hồi tầng pod tính bằng giây thay vì phút&lt;br&gt;&lt;br&gt;&lt;b&gt;Giữ nguyên:&lt;/b&gt; mạng đa AZ, RDS, ElastiCache, pgvector, cổng kiểm soát, log tập trung.&lt;br&gt;&lt;br&gt;&lt;b&gt;Chi phí:&lt;/b&gt; ~225 USD/tháng, trong đó control plane 73 USD cố định." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#879196;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2130" y="830" width="280" height="290" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
