        <!-- ============ LEGEND ============ -->
        <mxCell id="legend" value="&lt;b&gt;Chú giải&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Nền xanh Kubernetes&lt;/b&gt; = tài nguyên K8s (giống hệt hai bên)&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Biểu tượng AWS&lt;/b&gt; = dịch vụ quản lý&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Hộp trơn&lt;/b&gt; = máy ảo tự vận hành&lt;br&gt;&lt;b&gt;Nền hổ phách&lt;/b&gt; = dữ liệu khách hàng, không rời site&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Nền xanh nhạt&lt;/b&gt; = tri thức vận hành, nhân bản được&lt;br&gt;&lt;br&gt;━━ luồng nghiệp vụ&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#147EBA&quot;&gt;╌╌&lt;/font&gt; nhân bản tri thức&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#D86613&quot;&gt;━━&lt;/font&gt; hành động tầng pod&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#D86613&quot;&gt;╌╌&lt;/font&gt; hành động tầng node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7CEDC;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="1245" width="1940" height="130" as="geometry" />
        </mxCell>

        <!-- ============ NOTES ============ -->
        <mxCell id="n1" value="&lt;b&gt;Vì sao Kubernetes ở cả hai phía&lt;/b&gt;&lt;br&gt;&lt;br&gt;Không có K8s, bạn phải viết và bảo trì &lt;b&gt;hai bộ hoàn toàn khác nhau&lt;/b&gt;:&lt;br&gt;&lt;br&gt;• 2 tầng hành động (AWS API / OpenStack API)&lt;br&gt;• 2 pipeline triển khai&lt;br&gt;• 2 cơ chế rollback&lt;br&gt;• 2 cú pháp health check&lt;br&gt;&lt;br&gt;Với K8s hai phía, tất cả thu về &lt;b&gt;một&lt;/b&gt;. Đó là lý do duy nhất khiến EKS chuyển từ &quot;tuỳ chọn hay&quot; thành &quot;gần như bắt buộc&quot; trong phương án lai." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0FC;strokeColor=#326CE5;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2060" y="210" width="330" height="290" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="&lt;b&gt;Trừu tượng hoá 90%, không phải 100%&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Tầng pod — HỢP NHẤT&lt;/b&gt;&lt;br&gt;rollout undo · scale · cordon · drain · delete pod&lt;br&gt;→ cùng một lệnh, cùng một SDK, hai bên như nhau&lt;br&gt;&lt;br&gt;&lt;b&gt;Tầng node — VẪN KHÁC&lt;/b&gt;&lt;br&gt;OpenStack: nova rebuild, heat stack update&lt;br&gt;AWS: SetInstanceHealth, StartInstanceRefresh&lt;br&gt;→ vẫn cần hai bộ chuyển đổi nhỏ&lt;br&gt;&lt;br&gt;&lt;i&gt;Phần lớn hành động phục hồi nằm ở tầng pod, nên phần phải viết hai lần rất nhỏ.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#D86613;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2060" y="520" width="330" height="330" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="&lt;b&gt;Khác biệt lớn nhất giữa hai cụm&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;EKS&lt;/b&gt; — control plane do AWS quản lý. Trả 73 USD/tháng để &lt;i&gt;không phải&lt;/i&gt; vận hành etcd, không phải vá, không phải nâng cấp.&lt;br&gt;&lt;br&gt;&lt;b&gt;K8s trên OpenStack&lt;/b&gt; — control plane tự quản. Miễn phí, nhưng bạn gánh 3 master node, sao lưu etcd, vá bảo mật, nâng cấp phiên bản.&lt;br&gt;&lt;br&gt;&lt;i&gt;Đây là điểm đánh đổi rõ nhất của việc rời khỏi cloud công cộng — và cùng lý do với việc mất RDS.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF6F6;strokeColor=#A6192E;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2060" y="870" width="330" height="300" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="&lt;b&gt;Cái gì KHÔNG vào cụm Kubernetes&lt;/b&gt;&lt;br&gt;&lt;br&gt;• bankdb — CSDL ngân hàng giữ ngoài cụm, dùng Patroni trên VM&lt;br&gt;• aiopsdb — tách khỏi bankdb, khác vòng đời và quyền&lt;br&gt;• RDS, ElastiCache — vốn đã là dịch vụ quản lý&lt;br&gt;&lt;br&gt;&lt;i&gt;Chạy CSDL giao dịch trong K8s là khả thi nhưng thêm rủi ro không cần thiết cho ngân hàng.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEFD9;strokeColor=#96650A;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2060" y="1190" width="330" height="230" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
