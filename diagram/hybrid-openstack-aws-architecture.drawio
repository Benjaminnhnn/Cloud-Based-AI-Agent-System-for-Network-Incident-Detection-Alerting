        </mxCell>

        <!-- ===== NOTES ===== -->
        <mxCell id="n1" value="&lt;b&gt;Nguyên tắc thiết kế bắt buộc&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mỗi site phải hành động được trên tài nguyên của mình &lt;b&gt;kể cả khi mất kết nối&lt;/b&gt; với site kia.&lt;br&gt;&lt;br&gt;Vì thế mỗi bên có một Agent riêng và một bản tri thức riêng. Nếu vi phạm, đường VPN trở thành điểm hỏng duy nhất cho toàn bộ khả năng tự phục hồi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#D86613;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2060" y="210" width="330" height="180" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="&lt;b&gt;Site và môi trường là hai trục ĐỘC LẬP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Site&lt;/b&gt; quyết định bởi độ nhạy cảm dữ liệu.&lt;br&gt;&lt;b&gt;Môi trường&lt;/b&gt; quyết định bởi vòng đời phát hành.&lt;br&gt;&lt;br&gt;&lt;b&gt;PRODUCTION&lt;/b&gt;&lt;br&gt;OpenStack: payment-api, bankdb&lt;br&gt;AWS: frontend, kênh số&lt;br&gt;&lt;br&gt;&lt;b&gt;STAGING&lt;/b&gt;&lt;br&gt;AWS: toàn bộ, dữ liệu giả&lt;br&gt;&lt;br&gt;&lt;i&gt;Production là MỘT hệ thống trải hai site — không phải &quot;OpenStack là thật, AWS là thử&quot;.&lt;/i&gt;&lt;br&gt;&lt;br&gt;Cách tách staging bằng số cổng (8000 với 18000) biến mất hoàn toàn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F5FC;strokeColor=#2B5EBE;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2060" y="410" width="330" height="330" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="&lt;b&gt;Vì sao tách bankdb khỏi aiopsdb&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Kiểm soát thay đổi: bankdb chịu quy trình duyệt nghiêm ngặt, Agent thì ghi liên tục&lt;br&gt;• Phạm vi ảnh hưởng: lỗi trong mã Agent không được chạm tới sổ cái&lt;br&gt;• Sao lưu: giao dịch lưu nhiều năm, lịch sử sự cố thì không&lt;br&gt;• Phân tách trách nhiệm — yêu cầu tuân thủ&lt;br&gt;&lt;br&gt;&lt;i&gt;aiopsdb không cần HA: nếu chết, Agent suy giảm xuống chẩn đoán không RAG — chấp nhận được, và tiết kiệm 5 máy ảo.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6F7;strokeColor=#147EBA;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2060" y="760" width="330" height="290" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="&lt;b&gt;Ba kịch bản xuyên site — giá trị nghiên cứu&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;A. Lỗi dịch vụ hay lỗi đường truyền?&lt;/b&gt; Agent AWS thấy payment-api timeout. Agent OpenStack thấy payment-api khoẻ nhưng ít request đến. Chỉ khi ghép hai góc nhìn mới kết luận đúng: &lt;i&gt;đứt mạng, không được restart gì&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;B. Phân mảnh mạng.&lt;/b&gt; &quot;Site kia đã chết&quot; ≠ &quot;tôi không liên lạc được&quot;. Dùng điểm tham chiếu thứ ba để phân biệt.&lt;br&gt;&lt;br&gt;&lt;b&gt;C. Sự cố lan truyền.&lt;/b&gt; bankdb chậm → payment-api chậm → frontend 5xx. Alert nổ ở cả hai site cho một nguyên nhân gốc." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF6F6;strokeColor=#A6192E;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2060" y="1070" width="330" height="370" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
