        <!-- ===== LEGEND ===== -->
        <mxCell id="legend" value="&lt;b&gt;Chú giải&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Biểu tượng AWS&lt;/b&gt; = dịch vụ quản lý, không phải vận hành&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Hộp trơn&lt;/b&gt; = máy ảo tự vận hành&lt;br&gt;&lt;b&gt;Nền hổ phách&lt;/b&gt; = dữ liệu khách hàng&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Nền xanh nhạt&lt;/b&gt; = tri thức vận hành (nhân bản được)&lt;br&gt;&lt;br&gt;━━ luồng nghiệp vụ&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#147EBA&quot;&gt;╌╌&lt;/font&gt; nhân bản tri thức&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#D86613&quot;&gt;━━&lt;/font&gt; hành động tự phục hồi (luôn cục bộ)&lt;br&gt;&lt;br&gt;&lt;i&gt;Hai Agent KHÔNG gọi trực tiếp lẫn nhau — chúng chia sẻ tri thức qua kho được nhân bản.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7CEDC;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
