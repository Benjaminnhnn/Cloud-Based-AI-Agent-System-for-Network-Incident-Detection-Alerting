        <!-- ============ NOTES ============ -->
        <mxCell id="note1" value="&lt;b&gt;Vì sao đây là điểm mấu chốt của đề tài&lt;/b&gt;&lt;br&gt;&lt;br&gt;Khi state đã rời khỏi EC2 (RDS, ElastiCache, pgvector), mọi instance đều có thể bị thay thế. Hành động phục hồi của AI Agent vì thế chuyển từ &lt;i&gt;SSH chạy lệnh shell tuỳ ý&lt;/i&gt; sang một tập lời gọi API có biên giới rõ ràng, lũy đẳng và tự đảo ngược — đi qua cổng kiểm soát trước khi chạm hạ tầng thật." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#D86613;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1810" y="300" width="270" height="200" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;Ghi chú chi phí&lt;/b&gt;&lt;br&gt;&lt;br&gt;NAT Gateway ở AZ-b để mờ vì có thể lược bỏ: dùng chung một NAT ở AZ-a tiết kiệm khoảng 35 USD/tháng. Đánh đổi: NAT thành điểm chết đơn lẻ cho lưu lượng &lt;i&gt;đi ra&lt;/i&gt;, nhưng không ảnh hưởng traffic người dùng vào qua ALB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#879196;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1810" y="530" width="270" height="180" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="&lt;b&gt;Khác biệt so với hiện tại&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 1 AZ → 2 AZ, 1 subnet public → 3 tầng subnet&lt;br&gt;• EC2 cố định + EIP → ALB + Auto Scaling&lt;br&gt;• PostgreSQL container → RDS Multi-AZ&lt;br&gt;• Redis container → ElastiCache&lt;br&gt;• ChromaDB đĩa local → pgvector trên RDS&lt;br&gt;• Kho runbook file JSON → bảng RDS&lt;br&gt;• Deploy scp+ssh → cloud-init kéo từ SSM&lt;br&gt;• Prometheus target ghi tay → ec2_sd theo thẻ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F5FC;strokeColor=#2B5EBE;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1810" y="740" width="270" height="220" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
