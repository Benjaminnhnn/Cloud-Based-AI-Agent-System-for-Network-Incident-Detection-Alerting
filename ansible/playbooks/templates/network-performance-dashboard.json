{
  "dashboard": {
    "title": "Network & Performance",
    "description": "Host-level network traffic, latency, load, disk I/O, and packet error visibility for incident diagnosis.",
    "tags": ["network", "performance", "incident-response"],
    "timezone": "browser",
    "refresh": "5s",
    "time": {"from": "now-6h", "to": "now"},
    "panels": [
      {
        "id": 1,
        "title": "Inbound Traffic by Host",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}}},
        "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(node_network_receive_bytes_total{device!=\"lo\"}[5m]))", "legendFormat": "{{instance}} RX"}]
      },
      {
        "id": 2,
        "title": "Outbound Traffic by Host",
        "type": "stat",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}}},
        "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m]))", "legendFormat": "{{instance}} TX"}]
      },
      {
        "id": 3,
        "title": "Packet Errors",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.1}, {"color": "red", "value": 1}]}}},
        "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
        "targets": [
          {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(node_network_receive_errs_total{device!=\"lo\"}[5m]))", "legendFormat": "{{instance}} RX errors"},
          {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(node_network_transmit_errs_total{device!=\"lo\"}[5m]))", "legendFormat": "{{instance}} TX errors"}
        ]
      },
      {
        "id": 4,
        "title": "Endpoint Latency",
        "type": "stat",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 2}]}}},
        "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "probe_duration_seconds{runbook=~\"nginx|api-proxy|payment-api\"}", "legendFormat": "{{runbook}} {{endpoint}}"}]
      },
      {
        "id": 5,
        "title": "Network Throughput by Host",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never"}}},
        "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
        "targets": [
          {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(node_network_receive_bytes_total{device!=\"lo\"}[5m]))", "legendFormat": "{{instance}} RX"},
          {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m]))", "legendFormat": "{{instance}} TX"}
        ]
      },
      {
        "id": 6,
        "title": "Endpoint Probe Success",
        "type": "state-timeline",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
        "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "mergeValues": true, "showValue": "always"},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "probe_success{runbook=~\"nginx|api-proxy|payment-api\"}", "legendFormat": "{{runbook}} {{endpoint}}"}]
      },
      {
        "id": 7,
        "title": "Normalized Load by Host",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
        "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 1}]}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}},
        "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "node_load1 / on(instance) count by (instance) (node_cpu_seconds_total{mode=\"idle\"})", "legendFormat": "{{instance}} load1/core"}]
      },
      {
        "id": 8,
        "title": "Disk I/O Throughput",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
        "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}},
        "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
        "targets": [
          {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(node_disk_read_bytes_total[5m]))", "legendFormat": "{{instance}} read"},
          {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(node_disk_written_bytes_total[5m]))", "legendFormat": "{{instance}} write"}
        ]
      },
      {
        "id": 9,
        "title": "Packet Drops",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 20, "w": 12, "h": 7},
        "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.1}, {"color": "red", "value": 1}]}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}},
        "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
        "targets": [
          {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(node_network_receive_drop_total{device!=\"lo\"}[5m]))", "legendFormat": "{{instance}} RX drops"},
          {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(node_network_transmit_drop_total{device!=\"lo\"}[5m]))", "legendFormat": "{{instance}} TX drops"}
        ]
      },
      {
        "id": 10,
        "title": "Disk I/O Operations",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 20, "w": 12, "h": 7},
        "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}},
        "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
        "targets": [
          {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(node_disk_reads_completed_total[5m]))", "legendFormat": "{{instance}} reads"},
          {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(node_disk_writes_completed_total[5m]))", "legendFormat": "{{instance}} writes"}
        ]
      }
    ],
    "schemaVersion": 37,
    "version": 0,
    "overwrite": true
  }
}
