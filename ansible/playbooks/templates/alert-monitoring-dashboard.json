{
  "dashboard": {
    "title": "Alert Monitoring",
    "description": "Incident triage dashboard for active alerts, service health, endpoint probes, and dependencies.",
    "tags": ["alerts", "monitoring", "incident-response"],
    "timezone": "browser",
    "refresh": "10s",
    "time": {"from": "now-6h", "to": "now"},
    "panels": [
      {
        "id": 1,
        "title": "Firing Critical Alerts",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
        "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(ALERTS{alertstate=\"firing\",severity=\"critical\"})", "legendFormat": "critical"}]
      },
      {
        "id": 2,
        "title": "Firing Warning Alerts",
        "type": "stat",
        "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "orange", "value": 3}]}}, "overrides": []},
        "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(ALERTS{alertstate=\"firing\",severity=\"warning\"})", "legendFormat": "warning"}]
      },
      {
        "id": 3,
        "title": "Offline Scrape Targets",
        "type": "stat",
        "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
        "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(up{job!=\"\"} == 0)", "legendFormat": "offline"}]
      },
      {
        "id": 4,
        "title": "AI Agent Queue Depth",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 500}, {"color": "red", "value": 800}]}}, "overrides": []},
        "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "aiops_celery_queue_depth", "legendFormat": "celery queue"}]
      },
      {
        "id": 5,
        "title": "Services Online",
        "type": "stat",
        "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 8}]}}, "overrides": []},
        "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(up == 1)", "legendFormat": "online"}]
      },
      {
        "id": 6,
        "title": "Services Offline",
        "type": "stat",
        "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
        "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(up == 0)", "legendFormat": "offline"}]
      },
      {
        "id": 7,
        "title": "Active Incident Triage",
        "type": "table",
        "gridPos": {"x": 0, "y": 4, "w": 24, "h": 8},
        "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}}}, "overrides": [{"matcher": {"id": "byName", "options": "Value"}, "properties": [{"id": "custom.cellOptions", "value": {"type": "color-background"}}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}]}]},
        "options": {"showHeader": true, "sortBy": [{"desc": true, "displayName": "Value"}], "footer": {"show": false}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "ALERTS{alertstate=\"firing\"}", "format": "table", "instant": true}]
      },
      {
        "id": 8,
        "title": "Endpoint Health Timeline",
        "type": "state-timeline",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 7},
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
        "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "mergeValues": true, "showValue": "always"},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "probe_success{runbook=~\"nginx|api-proxy|payment-api\"}", "legendFormat": "{{runbook}} {{component}}"}]
      },
      {
        "id": 9,
        "title": "Backend Dependency Health",
        "type": "state-timeline",
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 7},
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
        "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "mergeValues": true, "showValue": "always"},
        "targets": [
          {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "pg_up{runbook=\"postgresql\"}", "legendFormat": "postgres {{component}}"},
          {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "redis_up{runbook=\"redis\"}", "legendFormat": "redis {{component}}"},
          {"refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "up{service=\"ai-agent\"}", "legendFormat": "ai-agent {{instance}}"}
        ]
      },
      {
        "id": 10,
        "title": "Endpoint Probe Duration",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 19, "w": 12, "h": 7},
        "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never"}}},
        "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "probe_duration_seconds{runbook=~\"nginx|api-proxy|payment-api\"}", "legendFormat": "{{runbook}} {{endpoint}}"}]
      },
      {
        "id": 11,
        "title": "Container Freshness",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 19, "w": 12, "h": 7},
        "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 20}, {"color": "red", "value": 30}]}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never"}}},
        "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "time() - max by (instance, name) (container_last_seen{name=~\".*(frontend-web-staging|payment-api-staging|postgres-staging|ai-agent-staging|redis-cache-staging|redis-staging).*\"})", "legendFormat": "{{instance}} {{name}}"}]
      },
      {
        "id": 12,
        "title": "Alert History by Type",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 26, "w": 24, "h": 7},
        "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never"}}},
        "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
        "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (alertname, severity, service, runbook) (ALERTS{alertstate=\"firing\"})", "legendFormat": "{{severity}} {{alertname}} {{service}} {{runbook}}"}]
      }
    ],
    "schemaVersion": 37,
    "version": 0,
    "overwrite": true
  }
}
